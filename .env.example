# API（仅监听回环地址）
HOST=127.0.0.1
PORT=4567

# 随项目启动、且唯一允许验证的本地站点
FIXTURE_HOST=127.0.0.1
FIXTURE_PORT=4568
# fixed = 模拟运维修复环与长链后已上线的站点状态
FIXTURE_MODE=

# PostgreSQL（npm run pg:start 启动的本地实例）
PGHOST=127.0.0.1
PGPORT=55432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=url_migration

# 规范化与爬取规则
TRAILING_SLASH_MODE=keep
MAX_REDIRECTS=5
HTTP_TIMEOUT_MS=4000
